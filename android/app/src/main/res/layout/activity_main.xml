<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/title" android:textSize="28sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/intro" android:textSize="18sp" />
        <Button android:id="@+id/choose_file" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/choose_file" />
        <TextView android:id="@+id/file_details" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/no_file" android:textSize="18sp" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/clear_file" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/clear_file" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/download_notice" android:textSize="18sp" />
        <TextView android:id="@+id/transfer_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/development_status" android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
