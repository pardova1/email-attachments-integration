PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000
# Replace before production.
TOKEN_SIGNING_SECRET=change-me
# Storage/email providers remain adapters; never commit production credentials.

# Optional production notification provider (server only; verified sender domain required).
# CUSTOMER_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# CUSTOMER_EMAIL_FROM=notifications@your-verified-domain.example
# CUSTOMER_EMAIL_TIMEOUT_MS=10000

# Request admission limits per server instance; apply to each API independently.
# Defaults remain 100 total and 1 per customer. Validate higher settings under load.
# CONNECTION_MAX_ACTIVE_TOTAL=100
# CONNECTION_MAX_ACTIVE_PER_CUSTOMER=1

# Optional server-only durable key lifecycle provider. Provision Vault first.
# TRANSFER_KEY_VAULT_PROVIDER=vault-transit
# VAULT_ADDR=https://your-vault.example
# VAULT_TOKEN=
# VAULT_TRANSIT_MOUNT=transit
# VAULT_NAMESPACE=admin
# TRANSFER_KEY_VAULT_TIMEOUT_MS=10000

# Optional durable envelope vault. Keep the wrapping secret in a server secret manager.
# TRANSFER_KEY_VAULT_PROVIDER=supabase-envelope
# TRANSFER_KEY_WRAPPING_SECRET=<canonical base64 encoding of 32 random bytes>
# Requires SUPABASE_URL, SUPABASE_SECRET_KEY and encrypted_transfer_key_records migration.

# Optional hosted license checkout. Production requires a live Stripe server key.
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# PAYMENT_SUCCESS_URL=https://your-app.example/payment/success
# PAYMENT_CANCEL_URL=https://your-app.example/payment/cancel
# PAYMENT_PROVIDER_TIMEOUT_MS=10000

# Comma-separated HTTPS origins allowed to submit browser billing requests.
# Same-origin web deployments must include their exact app origin here.
# BILLING_ALLOWED_ORIGINS=https://your-app.example
