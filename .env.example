PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000
# Replace before production.
TOKEN_SIGNING_SECRET=change-me
# Storage/email providers remain adapters; never commit production credentials.

# Optional production notification provider (server only; verified sender domain required).
# CUSTOMER_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# CUSTOMER_EMAIL_FROM=notifications@your-verified-domain.example
# CUSTOMER_EMAIL_TIMEOUT_MS=10000
